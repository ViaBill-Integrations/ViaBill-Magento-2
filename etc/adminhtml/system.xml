<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="viabill" translate="label" sortOrder="1" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>ViaBill - Easy Monthy Payments</label>
                <attribute type="activity_path">payment/viabill/active</attribute>
                <group id="new_credentials" translate="label comment" sortOrder="100" showInDefault="1"
                       showInWebsite="0" showInStore="0">
                    <label>ViaBill Account Credentials</label>
                    <comment>
                        <![CDATA[Enter your ViaBill API key, API secret and PriceTag script. You can find these
                        values in your ViaBill merchant account. All three values are required for the payment
                        gateway and the PriceTags to work.]]>
                    </comment>
                    <field id="apikey" translate="label comment" sortOrder="110" type="obscure" showInDefault="1"
                           showInWebsite="0" showInStore="0">
                        <label>API Key</label>
                        <comment>
                            <![CDATA[Your ViaBill API key. For security, the saved value is displayed as
                            asterisks; leave the field unchanged to keep the currently stored key.]]>
                        </comment>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <config_path>payment/viabill/apikey</config_path>
                    </field>
                    <field id="secret" translate="label comment" sortOrder="120" type="obscure" showInDefault="1"
                           showInWebsite="0" showInStore="0">
                        <label>API Secret</label>
                        <comment>
                            <![CDATA[Your ViaBill API secret. For security, the saved value is displayed as
                            asterisks and is never revealed; leave the field unchanged to keep the currently
                            stored secret.]]>
                        </comment>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <config_path>payment/viabill/secret</config_path>
                    </field>
                    <field id="price_tag_script" translate="label comment" sortOrder="130" type="textarea"
                           showInDefault="1" showInWebsite="0" showInStore="0">
                        <label>PriceTag Script</label>
                        <comment>
                            <![CDATA[Paste the whole PriceTag script snippet provided by ViaBill. You may include
                            the opening and closing script tags; they are removed automatically when the script
                            is rendered.]]>
                        </comment>
                        <config_path>payment/viabill/price_tag_script</config_path>
                    </field>
                    <field id="signup_link" sortOrder="140" showInDefault="1" showInWebsite="0" showInStore="0">
                        <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Field\SignupLink</frontend_model>
                    </field>
                </group>
                <group id="module_configuration" translate="label" sortOrder="500" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Module Configuration</label>
                    <attribute type="expanded">1</attribute>
                    <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Fieldset\ModuleConfiguration</frontend_model>
                    <field id="active" translate="label" sortOrder="510" type="select" showInDefault="1"
                           showInWebsite="1" showInStore="0">
                        <label>Enable</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>payment/viabill/active</config_path>
                    </field>
                    <field id="title" translate="label comment" sortOrder="520" type="text" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Title</label>
                        <comment>
                            <![CDATA[Payment method Title will be shown on checkout page.]]>
                        </comment>
                        <config_path>payment/viabill/title</config_path>
                    </field>
                    <field id="sort_order" translate="label" type="text" sortOrder="525" showInDefault="1"
                           showInWebsite="1">
                        <label>Sort Order</label>
                        <frontend_class>validate-number</frontend_class>
                        <config_path>payment/viabill/sort_order</config_path>
                    </field>
                    <field id="description" translate="label comment" sortOrder="530" type="textarea"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Description</label>
                        <comment>
                            <![CDATA[Description for the payment method will be shown on checkout page.]]>
                        </comment>
                        <config_path>payment/viabill/description</config_path>
                    </field>
                    <field id="order_status_before_authorization" translate="label comment" sortOrder="540"
                           type="select" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Order status (After checkout is initiated)</label>
                        <comment>
                            <![CDATA[Set the status of the order before the payment is authorized.]]>
                        </comment>
                        <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
                        <config_path>payment/viabill/order_status_before_authorization</config_path>
                    </field>
                    <field id="order_status_after_authorization" translate="label comment" sortOrder="545"
                           type="select" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Order status (After the payment is authorized)</label>
                        <comment>
                            <![CDATA[Set the status of the order after the payment is authorized.]]>
                        </comment>
                        <source_model>Viabillhq\Payment\Model\Config\Source\Order\Status\PendingPayment</source_model>
                        <config_path>payment/viabill/order_status_after_authorization</config_path>
                    </field>
                    <field id="order_status_after_capture" translate="label comment" sortOrder="546"
                           type="select" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Order status (After the payment is captured)</label>
                        <comment>
                            <![CDATA[Set the status of the order after the payment is captured.]]>
                        </comment>
                        <source_model>Magento\Sales\Model\ResourceModel\Order\Status\Collection</source_model>
                        <config_path>payment/viabill/order_status_after_capture</config_path>
                    </field>
                    <field id="viabill_payment_action" translate="label" type="select" sortOrder="547"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Payment Action</label>
                        <source_model>Viabillhq\Payment\Model\Adminhtml\Source\PaymentAction</source_model>
                        <config_path>payment/viabill/viabill_payment_action</config_path>
                    </field>
                    <field id="test_transaction" translate="label comment" sortOrder="550" type="select"
                           showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Test Transactions Mode</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>
                            <![CDATA[If enabled, transactions will be marked as "test".]]>
                        </comment>
                        <config_path>payment/viabill/test_transaction</config_path>
                    </field>
                    <field id="debug" translate="label comment" sortOrder="560" type="select"
                           showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Debug Mode</label>
                        <source_model>Viabillhq\Payment\Model\Adminhtml\Source\DebugLevels</source_model>
                        <comment>
                            <![CDATA[If enabled, debug information will be saved to log.]]>
                        </comment>
                        <config_path>payment/viabill/debug</config_path>
                    </field>
                    <field id="hide_checkout" translate="label comment" sortOrder="570" type="select"
                           showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Hide in Checkout</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>
                            <![CDATA[If enabled, the Viabill payment mode will not be available in the checkout step.]]>
                        </comment>
                        <config_path>payment/viabill/hide_checkout</config_path>
                    </field>
                    <field id="admin_notifications_severity" translate="label" type="select" sortOrder="570"
                           showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Admin Notifications Severity</label>
                        <source_model>Viabillhq\Payment\Model\Adminhtml\Source\Notifications</source_model>
                        <config_path>payment/viabill/admin_notifications_severity</config_path>
                    </field>
                </group>
                <group id="module_info" translate="label" sortOrder="650" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Module Info</label>
                    <field id="module_info_field" translate="label" sortOrder="680" type="note"
                           showInDefault="1" showInWebsite="1" showInStore="0">
                        <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Field\ModuleInfoField</frontend_model>
                    </field>
                </group>
                <group id="price_tag" translate="label comment" sortOrder="800" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>PriceTag Settings</label>
                    <comment>
                        <![CDATA[Enable ViaBill's PriceTags to obtain the best possible conversion, and inform your
                        customers about ViaBill.]]>
                    </comment>
                    <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Fieldset\ModuleConfiguration</frontend_model>
                    <field id="notification" type="label" translate="label" sortOrder="810" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>
                            Enable ViaBill’s PriceTag to make your customers aware of the possibility and thereby
                            maximizing your conversion.
                        </label>
                        <comment>
                            Enable ViaBill’s PriceTag to make your customers aware of the possibility and thereby
                            maximizing your conversion.
                        </comment>
                        <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Field\Notice</frontend_model>
                        <depends>
                            <field id="show_on_product">0</field>
                            <field id="show_on_cart">0</field>
                            <field id="show_on_checkout">0</field>
                        </depends>
                    </field>
                    <field id="show_on_product" translate="label" type="select" sortOrder="820"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Enable on Product page</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>payment/viabill/price_tag_show_on_product</config_path>
                    </field>
                    <field id="show_on_cart" translate="label" type="select" sortOrder="830"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Enable on Cart Summary</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>payment/viabill/price_tag_show_on_cart</config_path>
                    </field>
                    <field id="show_on_checkout" translate="label" type="select" sortOrder="840"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Enable on Checkout Summary</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>payment/viabill/price_tag_show_on_checkout</config_path>
                    </field>
                </group>
                <group id="legal_note" translate="label comment" sortOrder="850" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Legal Note</label>
                    <comment>
                        <![CDATA[The legal note is a short information text shown to customers at checkout when ViaBill is selected as the payment method, such as a warning that borrowing money costs money.]]>
                    </comment>
                    <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Fieldset\ModuleConfiguration</frontend_model>
                    <field id="text" translate="label comment" type="textarea" sortOrder="870"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Text</label>
                        <comment>
                            <![CDATA[The legal note shown at checkout, in the language selected below.]]>
                        </comment>
                        <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Field\LegalNoteText</frontend_model>
                    </field>
                    <field id="language" translate="label comment" type="select" sortOrder="880"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Language</label>
                        <comment>
                            <![CDATA[Language of the default legal note. "Auto" uses the language of the store view.]]>
                        </comment>
                        <source_model>Viabillhq\Payment\Model\Adminhtml\Source\LegalNoteLanguage</source_model>
                        <config_path>payment/viabill/legal_note_language</config_path>
                    </field>
                    <field id="font_size" translate="label comment" type="text" sortOrder="890"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Font size</label>
                        <comment>
                            <![CDATA[Font size of the legal note, e.g. 14px, 0.9em or 90%. Leave empty to use the font size of your theme.]]>
                        </comment>
                        <backend_model>Viabillhq\Payment\Model\Adminhtml\Backend\LegalNoteFontSize</backend_model>
                        <config_path>payment/viabill/legal_note_font_size</config_path>
                    </field>
                    <field id="font_style" translate="label" type="select" sortOrder="900"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Font style</label>
                        <source_model>Viabillhq\Payment\Model\Adminhtml\Source\LegalNoteFontStyle</source_model>
                        <config_path>payment/viabill/legal_note_font_style</config_path>
                    </field>
                    <field id="color" translate="label comment" type="text" sortOrder="910"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Text color</label>
                        <comment>
                            <![CDATA[Color code of the legal note text, e.g. #cc0000. Leave empty to use the text color of your theme.]]>
                        </comment>
                        <backend_model>Viabillhq\Payment\Model\Adminhtml\Backend\LegalNoteColor</backend_model>
                        <config_path>payment/viabill/legal_note_color</config_path>
                    </field>
                    <field id="align" translate="label" type="select" sortOrder="920"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Text alignment</label>
                        <source_model>Viabillhq\Payment\Model\Adminhtml\Source\LegalNoteAlign</source_model>
                        <config_path>payment/viabill/legal_note_align</config_path>
                    </field>
                    <field id="margin_top" translate="label comment" type="text" sortOrder="922"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Margin top</label>
                        <comment>
                            <![CDATA[Space above the legal note, e.g. 4px or 0.5em. A negative value moves it closer to the payment method name.]]>
                        </comment>
                        <backend_model>Viabillhq\Payment\Model\Adminhtml\Backend\LegalNoteMargin</backend_model>
                        <config_path>payment/viabill/legal_note_margin_top</config_path>
                    </field>
                    <field id="margin_bottom" translate="label comment" type="text" sortOrder="924"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Margin bottom</label>
                        <comment>
                            <![CDATA[Space below the legal note, e.g. 4px or 0.5em.]]>
                        </comment>
                        <backend_model>Viabillhq\Payment\Model\Adminhtml\Backend\LegalNoteMargin</backend_model>
                        <config_path>payment/viabill/legal_note_margin_bottom</config_path>
                    </field>
                    <field id="margin_left" translate="label comment" type="text" sortOrder="926"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Margin left</label>
                        <comment>
                            <![CDATA[Space to the left of the legal note, e.g. 4px. A negative value moves it to the left.]]>
                        </comment>
                        <backend_model>Viabillhq\Payment\Model\Adminhtml\Backend\LegalNoteMargin</backend_model>
                        <config_path>payment/viabill/legal_note_margin_left</config_path>
                    </field>
                    <field id="extra_css" translate="label comment" type="textarea" sortOrder="930"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Extra CSS</label>
                        <comment>
                            <![CDATA[Optional CSS declarations applied to the legal note box, separated by semicolons (no selectors or braces), e.g. padding: 8px 12px; background-color: #fff8e1; border-left: 3px solid #f0b849; They are applied after the options above, so they can also override them.]]>
                        </comment>
                        <backend_model>Viabillhq\Payment\Model\Adminhtml\Backend\LegalNoteExtraCss</backend_model>
                        <config_path>payment/viabill/legal_note_extra_css</config_path>
                    </field>
                </group>
                <group id="viabill_try" translate="label" sortOrder="900" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Pay in 30 days Settings</label>
                    <comment>
                        <![CDATA[Enable ViaBill's Try before you Buy payment option to increase the sales.]]>
                    </comment>
                    <frontend_model>Viabillhq\Payment\Block\Adminhtml\System\Config\Fieldset\ModuleConfiguration</frontend_model>
                    <field id="active" translate="label" sortOrder="910" type="select"
                           showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Enable</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>payment/viabill/active_try</config_path>
                    </field>
                    <field id="title" translate="label comment" sortOrder="920" type="text"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Title</label>
                        <comment>
                            <![CDATA[Payment method Title will be shown on checkout page.]]>
                        </comment>
                        <config_path>payment/viabill/title_try</config_path>
                    </field>
                    <field id="description" translate="label comment" sortOrder="930" type="textarea"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Description</label>
                        <comment>
                            <![CDATA[Description for the payment method will be shown on checkout page.]]>
                        </comment>
                        <config_path>payment/viabill/description_try</config_path>
                    </field>
                </group>
            </group>
        </section>
    </system>
</config>
